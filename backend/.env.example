# ---- Backend local environment -------------------------------------------
# Copy to .env (never commit real secrets) or export these in your shell.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/customers
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Comma-separated origins allowed to call the API. Use "*" only for quick demos.
ALLOWED_ORIGIN=http://localhost:5173

# Optional overrides
# JPA_DDL_AUTO=update
# JPA_SHOW_SQL=true
# PORT=8080
